# Copy to .env and fill in values. Do not commit .env.

# LendingPad Web API — HTTP Basic Auth (credentials from LendingPad support).
# Your server IP or domain must be whitelisted by LendingPad.
LENDINGPAD_API_URL=https://api.lendingpad.com
LENDINGPAD_CONTACT=<guid from LendingPad>
LENDINGPAD_COMPANY=<guid from LendingPad>
LENDINGPAD_USERNAME=
LENDINGPAD_PASSWORD=
# Or one variable: LENDINGPAD_BASIC_AUTH=username:password

# Optional: single default LendingPad `user` GUID if you never send userId from the UI
# LENDINGPAD_USER=

# Optional: override the LO list (JSON array). Otherwise use config/lendingpad-users.json in the repo.
# LENDINGPAD_USERS_JSON=[{"name":"Jane Doe","id":"..."}]

# OpenAI
OPENAI_API_KEY=sk-...
CHATGPT_ASSISTANT_ID=

# Supabase (browser auth + saving jobs / intake history). Create project at https://supabase.com
# Run supabase/schema.sql in the SQL editor after creating the project.
# In Authentication → Users: add users (e.g. arashid@questrock.com) and set passwords in the Dashboard.
# In Authentication → URL Configuration: add Site URL and Redirect URLs for your Vercel domain and http://localhost:3000
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Vercel: names must match exactly — `SUPABASE_URL` + `SUPABASE_ANON_KEY` (or `NEXT_PUBLIC_SUPABASE_URL` / `NEXT_PUBLIC_SUPABASE_ANON_KEY`). Add under Project → Settings → Environment Variables for Production and Preview.

# Optional: local smoke test for the `jobs` table (`npm run test:supabase-jobs`)
# SUPABASE_TEST_EMAIL=arashid@questrock.com
# SUPABASE_TEST_PASSWORD=...
